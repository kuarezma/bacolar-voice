# Sinyalleşme sunucusu ayarları.
# Sunucuyu kendi makinenizde veya bir VPS'te çalıştırırken bu dosyayı
# .env olarak kopyalayıp doldurun; paketlenmiş uygulama bu değerleri
# kendi başlattığı yerel sunucuya aktarmaz, yalnızca elle çalıştırılan
# sunucu için geçerlidir.

# Sunucunun dinleyeceği port.
PORT=3001

# Boş bırakılırsa sunucuya erişebilen herkes bağlanabilir. Herkese açık bir
# adreste çalıştırıyorsanız doldurun; kullanıcılar aynı değeri uygulamadaki
# "Sunucu Şifresi" alanına girer.
BACOLAR_SERVER_TOKEN=

# TURN sunucusu. Tanımlanmazsa yalnızca STUN kullanılır ve simetrik NAT /
# CGNAT arkasındaki kullanıcılar birbirine bağlanamaz. Birden fazla adres
# virgülle ayrılır.
BACOLAR_TURN_URLS=
BACOLAR_TURN_USERNAME=
BACOLAR_TURN_CREDENTIAL=

# Sunucu durum dosyasının yolu (varsayılan: server/data.json).
BACOLAR_DATA_FILE=
